# Google Apps Script web-app URL (ends in /exec). Leave unset to route enquiries
# straight to WhatsApp instead of saving them to the Google Sheet.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
# Google Analytics 4 measurement ID (G-…). Unset = no analytics and no consent banner.
NEXT_PUBLIC_GA_ID=
# Cloudflare Turnstile site key (public). The matching secret key goes in the Apps Script's
# Script Properties as TURNSTILE_SECRET — never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: URL serving live events JSON (same shape as src/content/events.generated.json,
# e.g. a small worker that runs scripts/collect-events.mjs and caches it). Unset = bundled snapshot.
NEXT_PUBLIC_EVENTS_FEED_URL=
